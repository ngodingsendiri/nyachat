rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Akses hanya untuk akun yang login dengan Google (bukan anonim/email lain).
    // PIN keluarga dianggap "secret bersama" — hanya anggota keluarga yang tahu PIN.
    function signedInGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Data keanggotaan diri sendiri (members/uid). Digunakan oleh semua rules
    // untuk mengecek "apakah pengguna sudah jadi anggota/owner".
    // BUG-08 (historis, sudah diperbaiki): isMember pernah memakai
    // `get(path).exists`. get()/exists() dievaluasi server-side terhadap state
    // NYATA Firestore — TIDAK bergantung pada rules baca dokumen target (bukti:
    // bootstrap create member di bawah mengecek get(familyDoc).data.ownerId
    // padahal aturan read keluarga menolak non-anggota) — tapi ada jendela
    // eventual-consistency sesaat setelah create member sehingga evaluasi bisa
    // menolak operasi walau member valid ("Gagal sinkron"). Pindah ke fungsi
    // built-in `exists()` yang dievaluasi tanpa perantara resource membuat
    // evaluasi tidak lagi sensitif terhadap jendela itu.
    function memberPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
    }
    function isMember(familyId) {
      return exists(memberPath(familyId));
    }
    // isOwner memakai get() (bukan exists()) karena perlu membaca FIELD role.
    // Aman — dua alasan: (1) get() dikembalikan server-side terhadap state nyata
    // tanpa bergantung pada rules baca dokumen target (lihat bukti bootstrap di
    // atas), dan (2) path yang dibaca selalu member doc user SENDIRI yang baca-
    // nya dijamin aturan self-read (request.auth.uid == uid), jadi evaluasi
    // tidak pernah jatuh ke null saat user benar-benar owner.
    function isOwner(familyId) {
      return isMember(familyId)
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    // Dokumen workspace keluarga (document id = PIN). Hanya berisi ownerId +
    // createdAt. PENTING (perbaikan keamanan FASE P1):
    //   - READ dibatasi untuk anggota/pemilik saja — sebelumnya ownerId bocor ke
    //     SEMUA akun Google yang login dan dokumen ini menjadi oracle enumerasi PIN.
    //   - Non-anggota yang mengecek keberadaan PIN TIDAK membaca dokumen ini;
    //     mereka mengirim joinRequest, dan rules menolak create bila keluarga
    //     tidak ada (exists() dievaluasi server-side tanpa butuh hak baca pemohon).
    //     Trade-off: keberadaan PIN tetap bisa diketahui lewat hasil joinRequest,
    //     tapi TANPA membocorkan identitas pemilik.
    //   - CREATE hanya boleh oleh pemohon yang menulis ownerId-nya sendiri
    //     (mencegah merebut/menimpa dokumen keluarga orang lain). Trade-off yang
    //     disengaja: pengguna Google yang login bisa "mendaftarkan" PIN (squatting)
    //     sebelum pemilik asli membuatnya. Risikonya kecil karena PIN 8 digit
    //     di-generate app tepat sebelum dibagikan, jadi jendela squatt-nya sempit.
    match /families/{familyId} {
      allow read: if signedInGoogle() && (isMember(familyId) || isOwner(familyId));
      allow create: if signedInGoogle()
        && request.resource.data.ownerId == request.auth.uid;
      // r1.6.0: update doc keluarga dibatasi HANYA field 'name' (rename workspace)
      // & 'plan' (langganan) oleh owner — mengikuti pola audit (owner tidak lagi
      // bisa menulis field sembarang).
      allow update: if signedInGoogle() && isOwner(familyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'plan']);
      allow delete: if signedInGoogle() && isOwner(familyId);
    }

    // Daftar anggota. Bisa dibaca oleh sesama anggota (atau diri sendiri saat
    // masih menunggu persetujuan). Hanya owner yang menambah/mengubah/menghapus,
    // kecuali pembuat workspace (ownerId di dokumen keluarga) boleh menciptakan
    // dokumen member-nya sendiri (bootstrap & migrasi workspace lama).
    match /families/{familyId}/members/{uid} {
      allow read: if signedInGoogle() && (isMember(familyId) || request.auth.uid == uid);
      allow create: if signedInGoogle()
        && (isOwner(familyId)
            || (request.auth.uid == uid
                && get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid));
      // 3.7: selain owner, setiap anggota boleh meng-update HANYA field fcmToken
      // miliknya sendiri — sinkronisasi token FCM untuk notifikasi chat real-time.
      // r1.2.3 (P1): avatarBytes/avatarVersion juga boleh di-update diri sendiri
      // — upload foto avatar (Blob JPEG kecil ≤ ~100KB) + versinya. Batas ukuran
      // mencegah klien tak patuh mengisi dokumen member dengan data besar.
      // Audit keanggotaan: 'name' & 'label' juga boleh di-update diri sendiri —
      // sinkron nama pilihan user ke member doc (identitas koheren lintas
      // perangkat). 'label' hanya ditulis klien saat masih default (kosong/==
      // nama lama) sehingga label kustom owner tidak tertimpa.
      // r1.7.0 (E2EE): 'e2eePubKey' & 'e2eeKeyVersion' boleh di-update diri
      // sendiri — public key perangkat untuk wrap grup key (EciesWrap).
      // Audit workspace (2026-08-12):
      //   - update milik OWNER dibatasi HANYA field 'role' & 'label' (sebelumnya
      //     owner bisa menulis field apa pun, mis. menimpa name/email anggota).
      //   - owner TIDAK boleh menurunkan dirinya sendiri jadi member (self-demote)
      //     — mencegah workspace kehilangan semua owner karena kecelakaan/malware.
      //     Transfer kepemilikan tetap bisa: owner A promote B, lalu B demote A.
      allow update: if signedInGoogle() && ((isOwner(familyId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'label'])
            && !(uid == request.auth.uid
                 && resource.data.role == 'owner'
                 && request.resource.data.role == 'member'))
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'avatarBytes', 'avatarVersion', 'name', 'label', 'photoUrl', 'lastActiveAt', 'e2eePubKey', 'e2eeKeyVersion'])
            // r1.4.0 (avatar foto): photoUrl boleh di-update diri sendiri —
            // URL foto Google disegarkan saat connect/rename.
            // Guard: avatarBytes boleh tidak ada (update hanya fcmToken) —
            // jangan panggil .size() pada field null (error evaluasi rules).
            && (!('avatarBytes' in request.resource.data)
                || request.resource.data.avatarBytes.size() <= 100000)
            // r1.6.0 (presence): lastActiveAt wajib ditulis via server timestamp
            // (heartbeat memakai FieldValue.serverTimestamp) — klien tidak bisa
            // mengirim jam palsu/maju ke masa depan untuk tampak online terus.
            // request.time == nilai server timestamp saat write dievaluasi.
            // PENTING: cek via diff().affectedKeys() — request.resource.data
            // adalah doc HASIL MERGE (berisi nilai lastActiveAt lama dari doc),
            // sehingga guard `'lastActiveAt' in request.resource.data` akan
            // selalu true setelah heartbeat pertama & menolak SEMUA self-update
            // lain (FCM token/avatar) yang ikut membawa nilai lastActiveAt lama.
            && (!('lastActiveAt' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.lastActiveAt == request.time)));
      // Audit workspace: owner tidak bisa menghapus owner lain LANGSUNG — harus
      // di-demote jadi anggota dulu. Mencegah workspace yatim tanpa pemilik
      // (guard "Pemilik tidak bisa dihapus" kini ditegakkan di UI & rules).
      // r1.4.0 (keluar dari workspace): siapa pun boleh menghapus doc-nya
      // SENDIRI (self-leave) — termasuk owner. Guard "workspace tidak boleh
      // yatim" (harus ada owner lain / promote dulu) ditegakkan di sisi APP
      // (leaveWorkspace menghitung owner lain sebelum delete) karena Firestore
      // rules TIDAK bisa query daftar member. Trade-off disengaja: klien nakal
      // bisa membuat workspace yatim, tapi tidak bisa merusak data orang lain.
      // Owner tetap TIDAK bisa self-demote diam-diam (guard update di atas).
      allow delete: if signedInGoogle() && isOwner(familyId)
        && resource.data.role != 'owner';
      allow delete: if signedInGoogle() && request.auth.uid == uid;
    }

    // Auto-connect (r1.4.0): query collectionGroup("members").whereEqualTo("uid", uid)
    // untuk menemukan workspace milik akun saat login ulang. WAJIB ada rule
    // recursive-wildcard ini — tanpa itu Firestore menolak query collectionGroup
    // dengan PERMISSION_DENIED (bug yang baru terungkap di uji emulator 2026-08-14:
    // auto-connect gagal diam-diam dan user diarahkan ke layar buat PIN padahal
    // akun sudah terikat workspace). Filter `resource.data.uid == request.auth.uid`
    // memastikan user hanya membaca member doc MILIKNYA sendiri — tidak bisa
    // meng-enumerasi anggota workspace lain. Untuk baca langsung per-doc, rule
    // spesifik /families/{familyId}/members/{uid} tetap menang (lebih ketat).
    match /{path=**}/members/{memberId} {
      allow read: if signedInGoogle() && resource.data.uid == request.auth.uid;
    }

    // Permintaan bergabung: pemohon boleh membuat/mengubah/mencabut permintaan
    // miliknya sendiri; owner boleh melihat semua & menindaklanjuti (setujui/tolak),
    // termasuk menghapus permintaan. Guard tambahan:
    //   - create/update hanya jika keluarga benar-benar ADA (exists()),
    //   - dan (kecuali owner) pemohon BELUM menjadi anggota — mencegah request
    //     ulang berulang / duplikasi.
    // M6 (audit): batas laju sisi server —
    //   - `requestedAt` wajib berada di jendela wajar relatif `request.time`
    //     (maks ~24 jam lalu) sehingga pemohon tidak bisa mengirim timestamp
    //     palsu/time-travel untuk melewati cooldown;
    //   - request ulang (update) oleh pemohon sendiri dibatasi minimal 5 menit
    //     sejak permintaan sebelumnya (dibandingkan via resource.data.requestedAt);
    //     owner tidak dibatasi. Ini melengkapi PinAttemptLimiter sisi klien
    //     (yang hanyabisa di-bypass di sisi server).
    match /families/{familyId}/joinRequests/{uid} {
      allow create: if signedInGoogle()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/families/$(familyId))
        && !isMember(familyId)
        && !exists(/databases/$(database)/documents/families/$(familyId)/joinRequests/$(request.auth.uid))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.requestedAt is number
        && request.resource.data.requestedAt <= request.time.toMillis()
        && request.resource.data.requestedAt >= request.time.toMillis() - 90000000;
      allow update: if signedInGoogle()
        && (isOwner(familyId)
            || (request.auth.uid == uid
                && request.resource.data.requestedAt is number
                && resource.data.requestedAt is number
                && request.resource.data.requestedAt >= resource.data.requestedAt + 300000));
      allow delete: if signedInGoogle() && (request.auth.uid == uid || isOwner(familyId));
      allow read: if signedInGoogle() && (request.auth.uid == uid || isOwner(familyId));
    }

    // PENTING: rules Firestore TIDAK menurun ke subkoleksi.
    // Subkoleksi messages & transactions WAJIB di-match eksplisit.
    // Hanya ANGGOTA (yang sudah disetujui owner) yang bisa baca/tulis.
    // M3 (audit): validasi skema — cloudId wajib == docId, text tidak kosong,
    // timestamps bertipe number (bukan string), supaya anggota tidak bisa
    // menulis dokumen tak valid yang merusak data keluarga lain.
    //
    // CATATAN (audit keanggotaan): sender TIDAK diikat ke identitas penulis.
    // Trade-off yang disengaja & didokumentasikan:
    //   1) Pesan AI memakai sender reserved "AI" yang ditulis oleh anggota mana
    //      pun yang bertanya — binding rules akan memblokirnya.
    //   2) Nama sender bisa diedit user (onboarding/ganti nama); binding ke
    //      member doc butuh sinkronisasi nama dua arah yang rawan putus saat
    //      offline-first (kirim pertama ditolak = data hilang).
    // Implikasi: anggota keluarga (yang sudah dipercaya via PIN + persetujuan
    // owner) bisa menulis atas nama anggota lain. Dampak terbatas karena semua
    // anggota sudah punya akses baca-tulis penuh ke data keluarga; identitas
    // dijaga koheren di sisi klien (nama disinkronkan ke member doc saat
    // connect/rename — lihat MembershipManager.updateMyIdentity).
    match /families/{familyId}/messages/{docId} {
      allow read: if signedInGoogle() && isMember(familyId);
      // r1.7.0 (E2EE): server TIDAK bisa memvalidasi isi yang terenkripsi —
      // validasi dipecah per msgVersion:
      //   - 1 (terenkripsi): WAJIB ada `enc` (ciphertext) + `msgVersion`; field
      //     konten (messageText/detected*) TIDAK lagi diperiksa (tidak ada).
      //   - 0 / absen (legacy plaintext): pemeriksaan lama (messageText).
      // Klien lama (pra r1.7.0) tidak menulis msgVersion → dianggap 0.
      function validEncryptedMessage() {
        return request.resource.data.msgVersion == 1
          && request.resource.data.enc is string
          && request.resource.data.enc.size() > 0
          && request.resource.data.enc.size() <= 600000;
      }
      function validPlaintextMessage() {
        return (!('msgVersion' in request.resource.data)
            || request.resource.data.msgVersion == 0)
          && request.resource.data.messageText is string;
      }
      // r1.6.1 (audit pesan): ikat senderUid ke penulis. Dipakai bersamaan
      // dengan FCM self-skip per-uid. Progresif: klien lama (pra r1.6.1) tidak
      // menulis senderUid → tetap diizinkan (tidak lebih buruk dari status quo);
      // klien baru WAJIB menulis uid-nya sendiri. imageUrl (path Storage) hanya
      // dibatasi tipenya — nilai path bebas selama dokumen valid.
      allow create: if signedInGoogle() && isMember(familyId)
        && request.resource.data.cloudId == docId
        && request.resource.data.sender is string
        && request.resource.data.sender.size() > 0
        && request.resource.data.timestamp is number
        && (validEncryptedMessage() || validPlaintextMessage())
        && (!('senderUid' in request.resource.data)
            || request.resource.data.senderUid == request.auth.uid)
        && (!('imageUrl' in request.resource.data)
            || request.resource.data.imageUrl is string);
      allow update: if signedInGoogle() && isMember(familyId)
        && request.resource.data.cloudId == docId
        && request.resource.data.sender is string
        && request.resource.data.sender.size() > 0
        && request.resource.data.timestamp is number
        && (validEncryptedMessage() || validPlaintextMessage())
        && (!('senderUid' in request.resource.data)
            || request.resource.data.senderUid == request.auth.uid)
        && (!('imageUrl' in request.resource.data)
            || request.resource.data.imageUrl is string);
      allow delete: if signedInGoogle() && isMember(familyId);
    }

    // r1.7.0 (E2EE) — ACK "sudah diterima" untuk chat ephemeral:
    // `families/{familyId}/messages/{docId}/deliveries/{uid}`. Setiap perangkat
    // menulis doc miliknya SENDIRI (uid == request.auth.uid) dengan server
    // timestamp; semua anggota boleh membaca (dipakai UI centang ✓✓). Cloud
    // function `cleanupDeliveredMessage` (admin SDK, bypass rules) menghapus
    // pesan begitu semua member menulis ACK.
    match /families/{familyId}/messages/{docId}/deliveries/{uid} {
      allow read: if signedInGoogle() && isMember(familyId);
      allow create, update: if signedInGoogle() && isMember(familyId)
        && request.auth.uid == uid
        && request.resource.data.deliveredAt is timestamp;
      allow delete: if signedInGoogle() && request.auth.uid == uid;
    }

    // r1.7.0 (E2EE) — marker aktivasi: `families/{familyId}/e2ee/e2ee`.
    // CREATE pertama yang menang (device OWNER membuatnya saat migrasi);
    // anggota tidak bisa mengubah/menghapus marker.
    match /families/{familyId}/e2ee/{markerDoc} {
      allow read: if signedInGoogle() && isMember(familyId);
      allow create: if signedInGoogle() && isMember(familyId)
        && request.resource.data.activated is timestamp;
      allow update, delete: if false;
    }

    // r1.7.0 (E2EE) — grup key yang di-wrap per perangkat:
    // `families/{familyId}/e2eeKeys/{uid}` berisi `e2eeKeyBytes` (EciesWrap).
    // Ditulis oleh anggota mana pun yang memegang grup key (self-heal) untuk
    // member {uid}; hanya dibatasi tipenya (server tidak bisa memvalidasi kripto).
    match /families/{familyId}/e2eeKeys/{uid} {
      allow read: if signedInGoogle() && isMember(familyId);
      allow create, update: if signedInGoogle() && isMember(familyId)
        && request.resource.data.e2eeKeyBytes is string
        && request.resource.data.e2eeKeyBytes.size() > 0
        && request.resource.data.e2eeKeyBytes.size() <= 5000;
      allow delete: if false;
    }

    // r1.7.1 (tanda terima/baca) — marker ringan per pesan terenkripsi:
    // `families/{familyId}/receipts/{cloudId}` berisi `deliveredBy` + `readBy`
    // (array uid, TANPA konten). Konten pesan dihapus server begitu semua
    // device menerima; marker ini bertahan sampai semua MEMBACA (titik pelangi)
    // atau TTL 14 hari. Setiap anggota hanya boleh MENAMBAH uid-nya sendiri;
    // array bersifat grow-only (ukuran tidak boleh mengecil — anti-hapus).
    match /families/{familyId}/receipts/{cloudId} {
      allow read: if signedInGoogle() && isMember(familyId);
      allow create, update: if signedInGoogle() && isMember(familyId)
        && request.resource.data.deliveredBy is list
        && request.resource.data.readBy is list
        && request.auth.uid in request.resource.data.deliveredBy
        && (resource == null
            || request.resource.data.deliveredBy.size() >= resource.data.deliveredBy.size())
        && (resource == null
            || request.resource.data.readBy.size() >= resource.data.readBy.size());
      allow delete: if false;
    }

    // Transaksi: selain validasi dasar, amount wajib angka positif (bukan
    // negatif/NaN) dan di bawah batas kewajaran — mencegah data korup dari
    // klien tak patuh. r1.7.0 (E2EE): transaksi terenkripsi hanya membawa
    // `enc` + `msgVersion` — validasi amount/type/category dilewati (server
    // tidak bisa membacanya; Rekap dihitung lokal di setiap perangkat).
    match /families/{familyId}/transactions/{docId} {
      allow read: if signedInGoogle() && isMember(familyId);
      function validEncryptedTx() {
        return request.resource.data.msgVersion == 1
          && request.resource.data.enc is string
          && request.resource.data.enc.size() > 0
          && request.resource.data.enc.size() <= 600000;
      }
      function validPlaintextTx() {
        return (!('msgVersion' in request.resource.data)
            || request.resource.data.msgVersion == 0)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount < 1000000000000
          && request.resource.data.type in ['PEMASUKAN', 'PENGELUARAN']
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0;
      }
      allow create: if signedInGoogle() && isMember(familyId)
        && request.resource.data.cloudId == docId
        && request.resource.data.timestamp is number
        && (validEncryptedTx() || validPlaintextTx());
      allow update: if signedInGoogle() && isMember(familyId)
        && request.resource.data.cloudId == docId
        && request.resource.data.timestamp is number
        && (validEncryptedTx() || validPlaintextTx());
      allow delete: if signedInGoogle() && isMember(familyId);
    }
  }
}
