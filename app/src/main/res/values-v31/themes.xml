<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen Android 12+ (API 31): background hitam solid supaya
    momen "logo saat instal/luncur" konsisten dengan launcher icon
    (hitam + logo). Ikon splash default = app icon (adaptive) sehingga
    logo tampil identik dengan ikon launcher.
-->
<resources>
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/black</item>
    </style>
</resources>
