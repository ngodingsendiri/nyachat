<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Splash screen Android 12+ (2026-08-12): background menyatu dengan tema
         app (splash_background light/dark otomatis via values-night) + logo
         adaptive icon. Setelah splash selesai, app lanjut ke Base theme —
         mencegah cold start tampil layar kosong lalu "melompat" ke UI. -->
    <!-- Catatan: postSplashScreenTheme & windowSplashScreenAnimationDuration adalah
         atribut library androidx core-splashscreen — TIDAK tersedia di framework
         tanpa dependency. Tanpa library: windowSplashScreenBackground + icon cukup
         (splash menampilkan logo di atas warna tema, lalu mulus ke Base theme).
         Tambahkan implementation("androidx.core:core-splashscreen") bila ingin
         durasi custom & post-splash yang eksplisit. -->
    <style name="Theme.MyApplication" parent="Theme.MyApplication.Base">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
